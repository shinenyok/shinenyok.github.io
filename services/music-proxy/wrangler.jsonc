{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cotool-music-proxy",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://www.shineyoki.top,https://shineyoki.top,http://localhost:8080,http://127.0.0.1:8080",
    "ALLOWED_HOSTS": "search.kuwo.cn,songsearch.kugou.com,lxmusicapi.onrender.com",
    "UPSTREAM_TIMEOUT_MS": "13000"
  }
}
